# Copy to .env for local development. Never commit .env.

# ——— Server ———
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info
# Comma-separated origins allowed to call the API cross-origin (empty = same-origin only).
CORS_ORIGINS=
TRUST_PROXY=false
# Used to build absolute share URLs, e.g. https://journeys.example.com
PUBLIC_BASE_URL=

# ——— Providers (server-side only) ———
# mock | railradar  (mock is rejected when NODE_ENV=production)
TRAIN_PROVIDER=mock
RAILRADAR_BASE_URL=
RAILRADAR_API_KEY=
OPENWEATHER_API_KEY=
OPENTOPOGRAPHY_API_KEY=
# OpenTopography's free key allows 50 calls/day. true = Open-Meteo (keyless) serves the terrain graph and the train's
# altitude and backs up OpenTopography; false = OpenTopography only.
ELEVATION_FALLBACK=true
OVERPASS_URL=https://overpass-api.de/api/interpreter
PROVIDER_TIMEOUT_MS=8000
PROVIDER_MAX_RETRIES=2

# ——— Caching & freshness ———
LIVE_CACHE_TTL_SECONDS=20
SEARCH_CACHE_TTL_SECONDS=900
ROUTE_CACHE_TTL_SECONDS=86400
FRESHNESS_FRESH_SECONDS=60
FRESHNESS_STALE_SECONDS=180
CLIENT_LIVE_POLL_MS=30000
SHARE_TTL_HOURS=48

# ——— Rate limits (requests per minute per client IP) ———
RATE_LIMIT_SEARCH_PER_MIN=60
RATE_LIMIT_LIVE_PER_MIN=120
RATE_LIMIT_SHARE_CREATE_PER_MIN=20
RATE_LIMIT_DEFAULT_PER_MIN=300

# ——— Client (exposed to the browser — must be safe to publish) ———
# MapTiler keys are necessarily visible to browsers; use a key restricted to your domains (Milestone 3).
VITE_MAPTILER_KEY=
