# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` for local development:   cp .env.example .env
# NEVER commit `.env` (it is git-ignored). This example file holds names only, no real values.
#
# On Vercel there is no .env file: add the same names in
#   Project → Settings → Environment Variables
# See DEPLOYMENT.md for exactly which ones.
# ─────────────────────────────────────────────────────────────────────────────

# ——— SECRET: server only (never sent to the browser) ———
RAILRADAR_API_KEY=
OPENWEATHER_API_KEY=
OPENTOPOGRAPHY_API_KEY=
# Signs share links so they work on serverless hosting. Required in production.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SHARE_SIGNING_SECRET=

# ——— Server settings (not secret) ———
# mock | railradar. "mock" serves simulated trains for offline development and is rejected in production.
TRAIN_PROVIDER=mock
# Required when TRAIN_PROVIDER=railradar:
RAILRADAR_BASE_URL=https://api.railradar.in/v1
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info
# Comma-separated origins allowed to call the API from another site (empty = same site only).
CORS_ORIGINS=
# Set true behind a proxy/load balancer. Switched on automatically on Vercel.
TRUST_PROXY=false
# Absolute site URL, e.g. https://your-app.vercel.app (optional)
PUBLIC_BASE_URL=

# OpenTopography's free key allows 50 calls/day. true = Open-Meteo (keyless) serves the terrain graph and the train's
# altitude and backs up OpenTopography; false = OpenTopography only.
ELEVATION_FALLBACK=true
OVERPASS_URL=https://overpass-api.de/api/interpreter
PROVIDER_TIMEOUT_MS=8000
PROVIDER_MAX_RETRIES=2

# ——— Caching & freshness ———
LIVE_CACHE_TTL_SECONDS=20
SEARCH_CACHE_TTL_SECONDS=900
ROUTE_CACHE_TTL_SECONDS=86400
FRESHNESS_FRESH_SECONDS=60
FRESHNESS_STALE_SECONDS=180
CLIENT_LIVE_POLL_MS=30000
SHARE_TTL_HOURS=48

# ——— Rate limits (requests per minute per client IP) ———
RATE_LIMIT_SEARCH_PER_MIN=60
RATE_LIMIT_LIVE_PER_MIN=120
RATE_LIMIT_SHARE_CREATE_PER_MIN=20
RATE_LIMIT_DEFAULT_PER_MIN=300

# ——— PUBLIC: baked into the website and visible to anyone who views it ———
# MapTiler requires a key in the browser. This is the ONLY variable that reaches the browser.
# In the MapTiler dashboard, restrict the key to your site's domain so nobody else can use it.
# (Vite reads it at build time, so on Vercel set it before you deploy.)
VITE_MAPTILER_KEY=
